# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CYBER_DAVID_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint. Workspace content is sent to this provider.
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
# true = backend only (no Vite/web companion); ideal for Android deployment
API_ONLY=false
# Optional persistent storage directory, default ./data
# DATA_DIR=/app/data
