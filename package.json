{
  "name": "forge-hacks",
  "private": true,
  "version": "1.0.0",
  "description": "Forge — an agentic AI workspace: vibe coding, agentic repo editing, code sandbox, long-context analysis, skills and governed extensions.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node server/src/index.js",
    "preview": "npm run build && node server/src/index.js",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
